# ==========================================
# Environment & Secrets
# ==========================================

.env
.env.*
!.env.example

*.secret
*.secrets

# Real Kubernetes secrets
**/secret.yaml
**/secrets.yaml

# Keep secret templates
!**/secret-template.yaml


# ==========================================
# Terraform
# ==========================================

# Terraform working directory
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# Keep example variables
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# ==========================================
# Docker
# ==========================================

docker-compose.override.yml

# Docker local secrets
docker-secrets.env


# ==========================================
# Logs
# ==========================================

*.log
logs/


# ==========================================
# OS
# ==========================================

.DS_Store
Thumbs.db
desktop.ini


# ==========================================
